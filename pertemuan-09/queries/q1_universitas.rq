SELECT ?universitas ?universitasLabel ?kota ?kotaLabel
WHERE {
  ?universitas wdt:P31 wd:Q3918 ;
               wdt:P17 wd:Q252 ;
               wdt:P131 ?kota .

  ?universitas rdfs:label ?universitasLabel .
  ?kota rdfs:label ?kotaLabel .

  FILTER(LANG(?universitasLabel) = "id")
  FILTER(LANG(?kotaLabel) = "id")
}
LIMIT 20
