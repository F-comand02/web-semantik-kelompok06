    <!-- http://kuliner-medan.org/ontology#KulinerShape -->

    <NamedIndividual rdf:about="http://kuliner-medan.org/ontology#KulinerShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <sh:property>
            <rdf:Description>
                <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
                <sh:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sh:maxInclusive>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minInclusive>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#tingkatKepedasan"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#Kategori"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#kategori"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#PengaruhBudaya"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#pengaruhBudaya"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#BahanUtama"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#memilikiBahan"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#Restoran"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#rekomendasiTempat"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:message xml:lang="id">Setiap kuliner wajib memiliki label @id dan @en.</sh:message>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sh:minCount>
                <sh:path rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:message xml:lang="id">Deskripsi wajib diisi.</sh:message>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://schema.org/description"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:message xml:lang="id">URL gambar harus HTTPS valid.</sh:message>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://schema.org/image"/>
                <sh:pattern>^https?://</sh:pattern>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#isHalal"/>
            </rdf:Description>
        </sh:property>
        <sh:targetClass rdf:resource="http://kuliner-medan.org/ontology#Kuliner"/>
    </NamedIndividual>
    


    <!-- http://kuliner-medan.org/ontology#RestoranShape -->

    <NamedIndividual rdf:about="http://kuliner-medan.org/ontology#RestoranShape">
        <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
        <sh:property>
            <rdf:Description>
                <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://schema.org/address"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://schema.org/name"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#Kelurahan"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#berlokasiDiKelurahan"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#Kecamatan"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://kuliner-medan.org/ontology#berlokasiDi"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <sh:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.85</sh:maxInclusive>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.40</sh:minInclusive>
                <sh:path rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#lat"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:class rdf:resource="http://kuliner-medan.org/ontology#TitikKoordinat"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:path rdf:resource="http://schema.org/geo"/>
            </rdf:Description>
        </sh:property>
        <sh:property>
            <rdf:Description>
                <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <sh:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">98.85</sh:maxInclusive>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">98.50</sh:minInclusive>
                <sh:path rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#long"/>
            </rdf:Description>
        </sh:property>
        <sh:targetClass rdf:resource="http://kuliner-medan.org/ontology#Restoran"/>
