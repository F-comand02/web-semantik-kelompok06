    <owl:NamedIndividual rdf:about="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#ArsikIkanMas">
        <rdf:type rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#Kuliner"/>
        <rdf:type rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#Makanan"/>
        <kategori rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#KatKulinerAdat"/>
        <memilikiBahan rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#BahanAndaliman"/>
        <memilikiBahan rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#BahanAsamCikala"/>
        <memilikiBahan rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#BahanIkanMas"/>
        <memilikiBahan rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#BahanKunyit"/>
        <memilikiPenghargaan rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#AwardWBTBKemendikbud"/>
        <pasanganCocok rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#DaunUbiTumbuk"/>
        <pengaruhBudaya rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#BudayaBatakToba"/>
        <profilRasa rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#RasaPedasAndaliman"/>
        <rekomendasiTempat rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#RMBatakTesalonika"/>
        <tagDiet rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#TagHalal"/>
        <teknikMasak rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#TeknikUngkep"/>
        <waktuSajian rdf:resource="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#WaktuMakanSiang"/>
        <hargaMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">65000</hargaMax>
        <hargaMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35000</hargaMin>
        <isHalal rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isHalal>
        <kisaranHarga>Rp 35.000 - Rp 65.000</kisaranHarga>
        <metodeMasak>Ungkep Rempah Lambat</metodeMasak>
        <rasaDominan>Pedas Getir Andaliman</rasaDominan>
        <tingkatKepedasan rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</tingkatKepedasan>
        <tingkatPopularitas rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</tingkatPopularitas>
        <schema:description xml:lang="id">Ikan mas utuh dimasak kering dengan bumbu kuning kunyit, andaliman, asam cikala, lokio (bawang Batak), dan kacang panjang khas Batak Toba.</schema:description>
        <schema:image>https://upload.wikimedia.org/wikipedia/commons/f/f3/Arsik_Ikan_Mas_2.jpg</schema:image>
        <rdfs:label xml:lang="id">Arsik Ikan Mas</rdfs:label>
        <rdfs:label xml:lang="en">Batak Spiced Yellow Carp</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://kuliner-medan.org/ontology/Kelompok06/KomA/25#AwardKesawanCityWalk -->

    <owl:NamedIndividual rdf:about="http://kuliner-medan.org/ontology/Kelompok06/KomA/25#AwardKesawanCityWalk">
