# 1. Soto Medan
ex:SotoMedan a ex:Kuliner ;
    rdfs:label "Soto Medan"@id , "Medan Coconut Beef Soup"@en ;
    schema:description "Soto berkuah santan kental berwarna kuning kehijauan dengan rempah jintan, kapulaga, dan isian daging sapi, ayam, atau udang."@id ;
    schema:image "https://images.unsplash.com/photo-1541832676-9b763b0239ab?auto=format&fit=crop&w=800&q=80" ;
    ex:kategori ex:KatMakananBerat ;
    ex:pengaruhBudaya ex:BudayaMelayu ;
    ex:waktuSajian ex:WaktuMakanSiang ;
    ex:memilikiBahan ex:BahanSantan , ex:BahanDagingSapi , ex:BahanDaunJeruk ;
    ex:isHalal true ;
    ex:tingkatKepedasan 2 ;
    ex:hargaMin 35000 ;
    ex:hargaMax 55000 ;
    ex:kisaranHarga "Rp 35.000 - Rp 55.000" ;
    ex:rasaDominan "Gurih Rempah & Creamy" ;
    ex:metodeMasak "Rebus & Tumis Rempah" ;
    ex:pasanganCocok ex:SateKerangMedan ;
    ex:rekomendasiTempat ex:RestoSotoSinarPagi ;
    owl:sameAs dbr:Soto_Medan .

