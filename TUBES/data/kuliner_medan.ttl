    schema:containedInPlace dbr:Medan .

ex:KecMedanPolonia a ex:Kecamatan ;
    rdfs:label "Medan Polonia"@id ;
    schema:containedInPlace dbr:Medan .

ex:KecMedanTimur a ex:Kecamatan ;
    rdfs:label "Medan Timur"@id ;
    schema:containedInPlace dbr:Medan .

ex:KecMedanArea a ex:Kecamatan ;
