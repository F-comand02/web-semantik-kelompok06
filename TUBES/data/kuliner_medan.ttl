@prefix dbr:    <http://dbpedia.org/resource/> .

# ==============================================================================
# 1. CULINARY CATEGORIES (6 CATEGORIES)
# ==============================================================================
ex:KatMakananBerat a ex:Kategori ;
    rdfs:label "Makanan Berat"@id , "Main Course"@en ;
    schema:description "Hidangan utama khas Medan yang mengenyangkan dan kaya rempah."@id .

ex:KatOlehOleh a ex:Kategori ;
    rdfs:label "Oleh-Oleh Khas"@id , "Signature Souvenirs"@en ;
    schema:description "Kue dan panganan ikonik Medan yang populer sebagai buah tangan."@id .

ex:KatMinuman a ex:Kategori ;
    rdfs:label "Minuman Khas"@id , "Traditional Beverages"@en ;
    schema:description "Minuman segar, hangat, dan penambah stamina khas Kota Medan."@id .

ex:KatCamilan a ex:Kategori ;
    rdfs:label "Camilan & Street Food"@id , "Snacks & Street Food"@en ;
    schema:description "Jajanan pasar dan street food legendaris Medan."@id .

ex:KatSarapan a ex:Kategori ;
    rdfs:label "Sarapan Khas"@id , "Medan Breakfast"@en ;
    schema:description "Menu sarapan pagi favorit warga lokal Kota Medan."@id .

ex:KatKulinerMalam a ex:Kategori ;
    rdfs:label "Kuliner Malam"@id , "Night Culinary"@en ;
    schema:description "Hidangan ikonik yang paling nikmat disantap pada malam hari di Medan."@id .

# ==============================================================================
# 2. CULTURAL HERITAGE INFLUENCES (6 CULTURES)
# ==============================================================================
ex:BudayaMelayu a ex:PengaruhBudaya ;
    rdfs:label "Melayu Deli"@id , "Deli Malay"@en ;
    owl:sameAs dbr:Malay_cuisine .

ex:BudayaBatakToba a ex:PengaruhBudaya ;
    rdfs:label "Batak Toba"@id , "Toba Batak"@en ;
    owl:sameAs dbr:Batak_cuisine .

ex:BudayaBatakKaro a ex:PengaruhBudaya ;
    rdfs:label "Batak Karo"@id , "Karo Batak"@en ;
    owl:sameAs dbr:Karo_people .

ex:BudayaTionghoaMedan a ex:PengaruhBudaya ;
    rdfs:label "Tionghoa-Medan"@id , "Medan Chinese"@en ;
    owl:sameAs dbr:Chinese_Indonesian_cuisine .

ex:BudayaIndiaTamil a ex:PengaruhBudaya ;
    rdfs:label "India-Tamil"@id , "Tamil Indian"@en ;
    owl:sameAs dbr:Indian_Indonesian_cuisine .

ex:BudayaJawaMedan a ex:PengaruhBudaya ;
    rdfs:label "Akulturasi Jawa-Medan"@id , "Javanese-Medan Fusion"@en ;
    owl:sameAs dbr:Indonesian_cuisine .

# ==============================================================================
# 3. SERVING TIMES (4 TIMES)
# ==============================================================================
ex:WaktuSarapan a ex:WaktuSajian ;
    rdfs:label "Sarapan (Pagi)"@id , "Breakfast (Morning)"@en .

ex:WaktuMakanSiang a ex:WaktuSajian ;
    rdfs:label "Makan Siang"@id , "Lunch"@en .

ex:WaktuMakanMalam a ex:WaktuSajian ;
    rdfs:label "Makan Malam"@id , "Dinner"@en .

ex:WaktuSepanjangHari a ex:WaktuSajian ;
    rdfs:label "Sepanjang Hari"@id , "All Day"@en .

