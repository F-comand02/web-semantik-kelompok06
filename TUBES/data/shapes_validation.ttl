@prefix ex:     <http://kuliner-medan.org/ontology#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# ==============================================================================
# W3C SHACL VALIDATION SHAPES (Shapes Constraint Language)
# Validates data quality & structural integrity of kuliner_medan.ttl
# Test online at: https://shacl.org/playground/
# ==============================================================================

ex:KulinerShape a sh:NodeShape ;
    sh:targetClass ex:Kuliner ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Every culinary dish must have at least one rdfs:label."@en ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:message "Every culinary dish must include a schema:description."@en ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^https?://" ;
        sh:message "Every culinary dish must have a valid HTTP/HTTPS image URL."@en ;
    ] ;
    sh:property [
        sh:path ex:isHalal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Halal status must be a single boolean value (true or false)."@en ;
    ] ;
    sh:property [
        sh:path ex:tingkatKepedasan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 5 ;
        sh:message "Spice level must be an integer between 0 and 5."@en ;
    ] ;
    sh:property [
        sh:path ex:kategori ;
        sh:minCount 1 ;
        sh:class ex:Kategori ;
        sh:message "Every dish must link to a valid ex:Kategori entity."@en ;
    ] ;
    sh:property [
        sh:path ex:pengaruhBudaya ;
        sh:minCount 1 ;
        sh:class ex:PengaruhBudaya ;
        sh:message "Every dish must link to an ex:PengaruhBudaya entity."@en ;
    ] ;
    sh:property [
        sh:path ex:memilikiBahan ;
        sh:minCount 1 ;
        sh:class ex:BahanUtama ;
        sh:message "Every dish must have at least one ex:BahanUtama ingredient."@en ;
    ] ;
    sh:property [
        sh:path ex:rekomendasiTempat ;
        sh:minCount 1 ;
        sh:class ex:Restoran ;
        sh:message "Every dish must link to at least one ex:Restoran venue."@en ;
    ] .

ex:RestoranShape a sh:NodeShape ;
    sh:targetClass ex:Restoran ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every restaurant must have a schema:name."@en ;
    ] ;
    sh:property [
        sh:path schema:address ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every restaurant must have a schema:address."@en ;
    ] ;
    sh:property [
        sh:path ex:berlokasiDi ;
        sh:minCount 1 ;
        sh:class ex:Kecamatan ;
        sh:message "Every restaurant must link to a Medan district (ex:Kecamatan)."@en ;
    ] ;
    sh:property [
        sh:path geo:lat ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 3.40 ;
        sh:maxInclusive 3.80 ;
        sh:message "Latitude must fall within Medan City geographic bounds (3.40 to 3.80)."@en ;
    ] ;
    sh:property [
        sh:path geo:long ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 98.50 ;
        sh:maxInclusive 98.85 ;
        sh:message "Longitude must fall within Medan City geographic bounds (98.50 to 98.85)."@en ;
    ] .
