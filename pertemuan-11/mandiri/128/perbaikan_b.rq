CONSTRUCT {
    ?o ex:nama ?n .
}
WHERE {
    {
        SELECT ?o (SAMPLE(?nama) AS ?n)
        WHERE {
            VALUES ?o {
                dbr:Christopher_Nolan
                dbr:Joko_Anwar
                dbr:Mira_Lesmana
            }
            ?o (foaf:name|rdfs:label|schema:name) ?nama .
        }
        GROUP BY ?o
    }
}
