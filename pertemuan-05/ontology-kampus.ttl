<https://example.org/ontology/usu>
    rdf:type owl:Ontology .


#################################################################
# Object Properties
#################################################################

###  https://example.org/ontology/usu#enrolledIn
:enrolledIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Student ;
            rdfs:range :Department .


###  https://example.org/ontology/usu#managesLibrary
:managesLibrary rdf:type owl:ObjectProperty ;
                rdfs:domain :Organization ;
                rdfs:range :Library .


###  https://example.org/ontology/usu#memberOf
:memberOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Person ;
          rdfs:range :Organization .


###  https://example.org/ontology/usu#providesScholarship
:providesScholarship rdf:type owl:ObjectProperty ;
                     rdfs:domain :Organization ;
                     rdfs:range :Scholarship .


###  https://example.org/ontology/usu#takesCourse
:takesCourse rdf:type owl:ObjectProperty ;
             rdfs:domain :Student ;
             rdfs:range :Course .


###  https://example.org/ontology/usu#teaches
:teaches rdf:type owl:ObjectProperty ;
         rdfs:domain :Lecturer ;
         rdfs:range :Course .


###  https://example.org/ontology/usu#usesLaboratory
:usesLaboratory rdf:type owl:ObjectProperty ;
                rdfs:domain :Person ;
                rdfs:range :Laboratory .

:memberOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Organization .

:managesLibrary
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Library .

:providesScholarship
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Scholarship .


