@prefix : <https://example.org/ontology/usu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/ontology/usu>
    rdf:type owl:Ontology .


#################################################################
# Object Properties
#################################################################

:enrolledIn
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Student ;
    rdfs:range :Department .

:takesCourse
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Student ;
    rdfs:range :Course .

:teaches
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Lecturer ;
    rdfs:range :Course .

:usesLaboratory
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Laboratory .

:memberOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Organization .

:managesLibrary
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Library .

:providesScholarship
    rdf:type owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Scholarship .


#################################################################
# Data Properties
#################################################################

:hasName
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:hasNIM
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasStudentID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasEmail
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:hasPhoneNumber
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:hasAddress
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:hasCourseCode
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Course ;
    rdfs:range xsd:string .


#################################################################
# Classes
#################################################################

:Person
    rdf:type owl:Class .

:Student
    rdf:type owl:Class ;
    rdfs:subClassOf :Person .

:Lecturer
    rdf:type owl:Class ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Student .

:AssistantLecturer
    rdf:type owl:Class ;
    rdfs:subClassOf :Lecturer .

:Professor
    rdf:type owl:Class ;
    rdfs:subClassOf :Lecturer .

:Researcher
    rdf:type owl:Class ;
    rdfs:subClassOf :Person .

:GraduateStudent
    rdf:type owl:Class ;
    rdfs:subClassOf :Student .

:UndergraduateStudent
    rdf:type owl:Class ;
    rdfs:subClassOf :Student .

:Course
    rdf:type owl:Class .

:Department
    rdf:type owl:Class .

:Faculty
    rdf:type owl:Class .

:Laboratory
    rdf:type owl:Class .

:Library
    rdf:type owl:Class .

:Organization
    rdf:type owl:Class .

:Scholarship
    rdf:type owl:Class .


#################################################################
# Individuals
#################################################################

# Department
:departemen_informatika
    rdf:type owl:NamedIndividual ,
             :Department .


# Laboratory
:lab_jaringan
    rdf:type owl:NamedIndividual ,
             :Laboratory .


# Course
:web_semantik
    rdf:type owl:NamedIndividual ,
             :Course ;
    :hasCourseCode "PWS-01" .


# Lecturer
:dosen_nurul
    rdf:type owl:NamedIndividual ,
             :Lecturer ;
    :hasName "Dosen Nurul" ;
    :teaches :web_semantik .


#################################################################
# Students
#################################################################

:mahasiswa_yabesh
    rdf:type owl:NamedIndividual ,
             :Student ;
    :hasName "Yabesh Day Siahaan" ;
    :hasNIM "251402004" ;
    :hasStudentID "251402004" ;
    :enrolledIn :departemen_informatika ;
    :takesCourse :web_semantik ;
    :usesLaboratory :lab_jaringan .


:mahasiswa_farel
    rdf:type owl:NamedIndividual ,
             :Student ;
    :hasName "Farel" ;
    :enrolledIn :departemen_informatika ;
    :takesCourse :web_semantik ;
    :usesLaboratory :lab_jaringan .


:mahasiswa_william
    rdf:type owl:NamedIndividual ,
             :Student ;
    :hasName "William" ;
    :enrolledIn :departemen_informatika ;
    :takesCourse :web_semantik ;
    :usesLaboratory :lab_jaringan .


:mahasiswa_ray
    rdf:type owl:NamedIndividual ,
             :Student ;
    :hasName "Ray" ;
