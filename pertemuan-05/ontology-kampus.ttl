:hasAddress rdf:type owl:DatatypeProperty ;
            rdfs:domain :Person ;
            rdfs:range xsd:string .

:hasNIM
    rdf:type owl:DatatypeProperty ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasStudentID
    rdf:type owl:DatatypeProperty ;
