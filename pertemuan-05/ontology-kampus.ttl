              rdfs:range xsd:string .


#################################################################
# Classes
#################################################################

:Person
    rdf:type owl:Class .

:Student
    rdf:type owl:Class ;
    rdfs:subClassOf :Person .

:Lecturer
    rdf:type owl:Class ;
    rdfs:subClassOf :Person ;
    owl:disjointWith :Student .

:AssistantLecturer
    rdf:type owl:Class ;
    rdfs:subClassOf :Lecturer .


###  https://example.org/ontology/usu#Course
:Course rdf:type owl:Class .


###  https://example.org/ontology/usu#Department
:Department rdf:type owl:Class .


###  https://example.org/ontology/usu#Faculty
:Faculty rdf:type owl:Class .


###  https://example.org/ontology/usu#GraduateStudent
:GraduateStudent rdf:type owl:Class ;
                 rdfs:subClassOf :Student .


###  https://example.org/ontology/usu#Laboratory
:Laboratory rdf:type owl:Class .


###  https://example.org/ontology/usu#Lecturer
:Lecturer rdf:type owl:Class ;
          rdfs:subClassOf :Person ;
          owl:disjointWith :Student .


###  https://example.org/ontology/usu#Library
:Library rdf:type owl:Class .


###  https://example.org/ontology/usu#Organization
:Organization rdf:type owl:Class .


###  https://example.org/ontology/usu#Person
:Person rdf:type owl:Class .


###  https://example.org/ontology/usu#Professor
:Professor rdf:type owl:Class ;
           rdfs:subClassOf :Lecturer .

:Researcher
    rdf:type owl:Class ;
    rdfs:subClassOf :Person .

:GraduateStudent
    rdf:type owl:Class ;
    rdfs:subClassOf :Student .


